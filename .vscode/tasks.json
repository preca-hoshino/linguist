{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (Install)",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Frontend (Install)",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder:Linguist-Admin}" },
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "npx",
      "args": ["tsx", "watch", "--inspect", "src/index.ts"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Backend (Install)"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "tsx",
          "endsPattern": "listening on|Linguist LLM Gateway started|listening"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder:Linguist-Admin}" },
      "dependsOn": ["Frontend (Install)"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:.*http://localhost"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "Full Stack",
      "dependsOn": ["Backend", "Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "close": true }
    }
  ]
}
