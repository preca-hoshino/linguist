  {
    "id": "coding",
    "name": "VS Code Coding",
    "apiKey": "lin-proj-coding-secret",
    "icon": "githubcopilot",
    "meta": {
      "sessionId": "coding-main",
      "maxCharsLimit": 400000
    },
    "script": [
      "// ① 项目脚本：与 projects.json 字段完全对照 (ctx.project.meta / ctx.route.candidates)",
      "const limit = Number(ctx.project.meta.maxCharsLimit ?? 500000);",
      "if (ctx.request.signals.estimatedInputChars > limit) {",
      "  ctx.reject = { statusCode: 400, message: `Exceeded project char budget: ${limit}` };",
      "  return;",
      "}",
      "ctx.route.candidates = ctx.route.candidates.filter(c => c.provider.id !== 'codex');"
    ],
    "callModels": [
      {
        "id": "smart-coder",
        "name": "Smart Coder",
        "icon": "cursor",
        "meta": {
          "defaultEffort": "high",
          "preferSpeed": true
        },
        "script": [
          "// ② 调用模型脚本：直接读取 ctx.callModel.meta",
          "ctx.request.body.reasoning_effort ??= ctx.callModel.meta.defaultEffort;",
          "ctx.state.preferSpeed = Boolean(ctx.callModel.meta.preferSpeed);"
        ]
      }
    ]
  }
]
